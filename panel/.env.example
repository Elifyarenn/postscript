# ---------- Application ----------
# Public origin of the panel. Used for CSRF origin checks and e-mail links.
APP_URL=http://localhost:3001
NODE_ENV=development

# ---------- Database ----------
# PostgreSQL connection string (docker compose provides this service).
DATABASE_URL=postgres://postscript:postscript@localhost:5432/postscript

# ---------- Sessions ----------
# Extra secret mixed into the session token hash (pepper). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-bytes-hex
# Session lifetime and inactivity window, in days.
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_DAYS=7

# ---------- E-mail (SMTP) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="postscript <noreply@postscript.local>"

# ---------- Object storage (S3 compatible / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=postscript
S3_SECRET_ACCESS_KEY=postscript
# Public-ish bucket for article media and contract PDFs.
S3_BUCKET=postscript
S3_FORCE_PATH_STYLE=true

# ---------- Front-end revalidation ----------
# Called when an issue or article is published or withdrawn.
REVALIDATE_WEBHOOK_URL=
REVALIDATE_WEBHOOK_SECRET=

# ---------- Seed / first admin ----------
SEED_ADMIN_EMAIL=admin@postscriptmag.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin2026
SEED_ADMIN_NAME=Site Admin
